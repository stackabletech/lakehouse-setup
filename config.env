####################################################################################
# Everything environment-specific. scripts/apply.sh sources this and substitutes
# the values into the manifests as it applies them.
#
# Unset values fall back to minikube defaults, so an untouched checkout comes up
# on a local cluster with no editing. Setting them targets a real deployment.
####################################################################################

# ── Local stand-ins ──────────────────────────────────────────────────────────
# Whether to deploy testing/ - MinIO, PostgreSQL and Forgejo - alongside the
# platform. true on a laptop. Set it to false once an object store, a PostgreSQL
# server and a git repository exist elsewhere; apply.sh then requires the Secrets
# in examples/external-credentials.yaml and DAGS_GIT_REPO below.
#
# Default: true.
#LOCAL_STANDINS=false

# ── Where the products are reached ───────────────────────────────────────────
# The address every per-product hostname below falls back to. Defaults to the
# minikube node. On any other cluster set this, or set every one of
# KEYCLOAK_HOSTNAME, AIRFLOW_URL, TRINO_HOSTNAME, SUPERSET_HOSTNAME and
# NIFI_HOSTNAME - apply.sh stops and names what is missing otherwise.
#
# Behind a load balancer this is usually left unset and each product given its
# own hostname.
#EXTERNAL_HOST=lakehouse.example.com

# ── Keycloak ─────────────────────────────────────────────────────────────────
# The one address browsers AND products both use. It has to be a single value:
# products redirect browsers to the endpoints in Keycloak's discovery document,
# and the issuer in the resulting token has to match the one they were
# configured with.
#
# Default: the minikube node IP on NodePort 31443.
#KEYCLOAK_HOSTNAME=keycloak.example.com
#KEYCLOAK_PORT=443

# Which CA signed the certificate served AT that address - not the same question
# as which CA the platform uses. Getting it wrong is not a login error: Trino and
# NiFi fetch the discovery document at startup and CrashLoopBackOff with
# `PKIX path building failed` instead.
#
#   caCert: {secretClass: tls}    Keycloak reached directly. The default.
#   webPki: {}                    behind a load balancer with a public
#                                 certificate. The usual production answer.
#   caCert: {secretClass: NAME}   a private CA. See examples/external-ca.yaml.
#
# YAML flow style, because it substitutes as a single line, and it MUST be quoted
# - the value contains spaces and braces and this file is sourced by the shell.
#KEYCLOAK_CA="webPki: {}"

# Whether Keycloak derives token and userinfo endpoints from the incoming request
# instead of from the address above. `true` lets in-cluster clients reach it by
# Service name when there is no proxy.
#
# Behind a load balancer set it to false. A request-derived endpoint takes its
# host from the proxy's Host header, which carries no port, so anything not on
# 443 advertises a token endpoint nobody can reach - and the login then fails at
# the last step with `invalid_token_response`, after the user has already
# authenticated, which looks like the product's fault.
#
# Default: true.
#KEYCLOAK_BACKCHANNEL_DYNAMIC=false

# ── Airflow ──────────────────────────────────────────────────────────────────
# Airflow derives its OIDC redirect URI from this, so it must be the address the
# browser actually used, scheme included. Behind a TLS-terminating load balancer
# that scheme is https even though the pod itself serves plain HTTP.
#
# Default: http://<node ip>:31081
#AIRFLOW_URL=https://airflow.example.com

# ── NiFi ─────────────────────────────────────────────────────────────────────
# NiFi refuses a request whose Host header it does not recognise, so its public
# hostname has to be named explicitly. It is also the only product whose
# ListenerClass differs between the two topologies:
#
#   external-unstable   direct NodePort access. Puts the node address in the
#                       certificate, which NiFi's Jetty requires.
#   cluster-internal    behind a load balancer, which reaches the Service.
#
# Default: the node address, and external-unstable.
#NIFI_HOSTNAME=nifi.example.com
#NIFI_LISTENER_CLASS=cluster-internal

# ── Object store ─────────────────────────────────────────────────────────────
# Which CA signed the certificate the object store presents. Again not the same
# question as which CA the platform uses; against the local MinIO they happen to
# coincide, which is why the default works untouched.
#
#   caCert: {secretClass: tls}          the local MinIO. The default.
#   webPki: {}                          a publicly trusted endpoint.
#   caCert: {secretClass: external-ca}  a private CA. Apply
#                                       examples/external-ca.yaml first.
#
# S3_CA_VOLUME must name the same trust material as a volume source: Airflow
# writes task logs with boto3, which wants a CA file on disk rather than a
# SecretClass. Nothing checks the two agree, and a mismatch shows up only as task
# logs never arriving - the task itself still succeeds.
#
#   configMap: {name: cluster-internal-ca}   the platform CA. The default.
#   secret: {secretName: external-ca}        the Secret from external-ca.yaml.
#
# Under `webPki: {}` there is no file to mount: leave S3_CA_VOLUME at its default
# and drop the `verify` entry from AIRFLOW_CONN_S3_CONN instead, so boto3 uses
# its own bundled trust store. Both MUST be quoted.
#S3_CA="caCert: {secretClass: external-ca}"
#S3_CA_VOLUME="secret: {secretName: external-ca}"

# The same object store once more, as a whole URL, for the one client that reads
# no S3Connection: Airflow's boto3 log writer. It has to name the same endpoint
# as `host` and `port` in manifests/02-s3.yaml, and apply.sh stops if the two
# disagree - a mismatch is otherwise silent, the task succeeds and only its log
# is lost.
#
# Default: https://minio.<namespace>.svc.cluster.local:9000, which is right only
# while the object store shares the namespace being installed into.
#S3_ENDPOINT=https://s3.example.com:9000

# ── DAGs from git ────────────────────────────────────────────────────────────
# Airflow reads its DAGs from a git repository through git-sync; committing there
# is how a DAG is deployed. There is no ConfigMap and no volume to fill.
#
# REQUIRED when LOCAL_STANDINS is false - there is no default, and an unset value
# would point Airflow at a git server that does not exist. git-sync exits after
# repeated fetch failures, so the whole install comes up NotReady with the reason
# three containers deep; apply.sh stops with a message instead.
#
# The repository holds the contents of dags/ - commit them there, or replace them
# with your own. It may be private; see the credential note below.
#DAGS_GIT_REPO=https://gitlab.example.com/data-platform/airflow-dags.git

# The branch to clone, and the subdirectory holding the DAG files. `gitFolder`
# may be empty or `/` for the repository root; the rest is cloned either way,
# Airflow just does not parse it.
#
# Defaults: main, and dags.
#DAGS_GIT_BRANCH=production
#DAGS_GIT_FOLDER=airflow/dags

# Which CA signed the git server's certificate. This is the whole value of the
# AirflowCluster's `tls:` field, so YAML flow style, and it MUST be quoted.
#
#   {verification: {server: {caCert: {webPki: {}}}}}         github.com, gitlab.com
#   {verification: {server: {caCert: {secretClass: tls}}}}   a git server inside
#                                 the cluster serving the platform's own CA. The
#                                 default, and almost certainly not what you want.
#   {verification: {server: {caCert: {secretClass: external-ca}}}}
#                                 a private CA. Apply examples/external-ca.yaml.
#   null                          a repository reached over plain `http://`.
#
# IMPORTANT - this has to agree with the scheme of DAGS_GIT_REPO. An `http://`
# repository with anything but `null` makes the operator refuse the whole
# AirflowCluster with `scheme does not match tls setting`, and it says so in its
# own log only: the object is accepted, `.status` stays empty, no Event is
# emitted, no StatefulSet appears.
#DAGS_GIT_TLS="{verification: {server: {caCert: {webPki: {}}}}}"

# The credential git-sync presents is the `airflow-git-credentials` Secret, not a
# value here. Fill it in in examples/external-credentials.yaml and apply that
# before apply.sh. A GitHub or GitLab token goes in `password`, its user in
# `user`.

# ── Trino and Superset ───────────────────────────────────────────────────────
# Used only to build examples/loadbalancer/ and to document which redirect URIs
# to register in Keycloak. Neither product needs its own address in its
# configuration: both derive the OIDC redirect from the incoming request, which
# is why they need the load balancer to send X-Forwarded-* headers.
#
# Default: the node address on the fixed NodePorts.
#TRINO_HOSTNAME=trino.example.com
#SUPERSET_HOSTNAME=superset.example.com
